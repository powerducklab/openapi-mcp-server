{
  "name": "@powerduck/openapi-mcp-server",
  "version": "1.3.3",
  "description": "Production-oriented OpenAPI to MCP server library with Tools, Prompts, Resources, Web UI, and admin runtime.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server/admin-server.d.ts",
      "import": "./dist/server/admin-server.mjs",
      "require": "./dist/server/admin-server.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "openapi-mcp": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json",
    "bundle": "tsup",
    "copy:webui": "node scripts/copy-webui.mjs",
    "build": "npm run clean && npm run typecheck && npm run bundle && npm run copy:webui",
    "dev": "tsx src/cli.ts serve --transport web",
    "start": "node dist/cli.mjs serve --transport web",
    "demo": "tsx demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openapi",
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "tools",
    "prompts",
    "resources",
    "api",
    "rest",
    "swagger",
    "codegen",
    "server",
    "cli"
  ],
  "author": "Powerduck limited",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/powerducklab/openapi-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/powerducklab/openapi-mcp-server/issues"
  },
  "homepage": "https://www.powerduck.com/",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@powerduck/openapi-parser": "^0.3.5",
    "axios": "^1.20.0",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "terser": "^5.51.2",
    "js-yaml": "^5.4.1",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^2.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
